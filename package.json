{
  "name": "minidisc-manager",
  "version": "0.1.0",
  "description": "Manage NetMD MiniDisc players: read discs, rename, reorder, erase, and transfer MP3s in SP/LP2/LP4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "MiniDisc Manager",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.5.0",
    "netmd-js": "^4.4.1",
    "usb": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "productName": "MiniDisc Manager",
  "private": true,
  "build": {
    "appId": "local.minidisc.manager",
    "productName": "MiniDisc Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "node_modules/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": false,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiniDisc Manager",
      "artifactName": "MiniDisc-Manager-Setup-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeclanGreen/minidisc-manager.git"
  }
}
